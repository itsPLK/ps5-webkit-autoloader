+/* WKAL: autoload a single payload from the shared payloads dir (../payloads/,
+   one level up from src/ — the same dir the autoloader's payload.elf lives in)
+   and send it to the running ELF loader on port 9021. connectToElfldr()
+   already retries until the loader is accepting, so no explicit wait is needed.
+   Returns the number of bytes sent. */
+export async function autoloadPayload(name, p, chain, log) {
+  const say = typeof log === "function" ? log : () => {};
+  say("mapping " + name + " from shared payloads dir");
+  const payload = await mapElf(name, p, chain, "../payloads/");
+  say("sending " + name + " to the ELF loader on port 9021");
+  await sendElf(name, payload, p, chain);
+  return payload.size;
 }
 
